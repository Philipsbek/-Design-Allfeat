---

<section class="prelude section" id="prelude">
  <div class="teal-wash prelude__wash"></div>
  <div class="container prelude__inner reveal">
    <span class="eyebrow">Prelude</span>
    <p class="prelude__statement">
      Allfeat provides a <span class="prelude__hi">universal, open-source,
      decentralized infrastructure</span> designed to secure and certify music IP
      — all powered by a scientific, non-profit foundation.
    </p>
  </div>
</section>

<style>
  .prelude {
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .prelude__wash {
    background: radial-gradient(
      50% 60% at 50% 50%,
      rgba(0, 177, 140, 0.16) 0%,
      transparent 70%
    );
  }

  .prelude__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
  }

  .prelude__statement {
    margin-top: 22px;
    font-size: clamp(24px, 4vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--color-ash-gray);
  }

  .prelude__hi {
    color: var(--color-warm-cream);
    font-weight: 600;
  }
</style>
