---
---

<section class="hero" id="solution">
  <div class="teal-wash"></div>
  <div class="container hero__inner">
    <div class="hero__head reveal">
      <span class="eyebrow">Our Solution</span>
      <h1 class="display hero__title">
        A shared foundation to connect
        <span class="muted">every layer of music data.</span>
      </h1>
      <p class="body-muted hero__sub">
        An open-source platform governed by the people who make music happen —
        artists, labels, publishers and collecting societies, on one trusted registry.
      </p>
    </div>

    <div class="hero__grid">
      <article class="card hero__card reveal">
        <div class="hero__art">
          <!-- Isometric glass cube on a teal grid with coral diamond accents -->
          <svg viewBox="0 0 600 380" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="cubeBg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0a3b30"/>
                <stop offset="0.5" stop-color="#0c4a3b"/>
                <stop offset="1" stop-color="#072019"/>
              </linearGradient>
              <linearGradient id="faceL" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#0e5847"/>
                <stop offset="1" stop-color="#0a4034"/>
              </linearGradient>
              <linearGradient id="faceR" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e9e6d3"/>
                <stop offset="1" stop-color="#c7c4b0"/>
              </linearGradient>
              <linearGradient id="faceT" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#fffbeb"/>
                <stop offset="1" stop-color="#dedbc7"/>
              </linearGradient>
              <radialGradient id="cubeGlow" cx="0.5" cy="0.42" r="0.55">
                <stop offset="0" stop-color="#12b394" stop-opacity="0.55"/>
                <stop offset="1" stop-color="#12b394" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <rect width="600" height="380" fill="url(#cubeBg)"/>
            <rect width="600" height="380" fill="url(#cubeGlow)"/>

            <!-- perspective grid floor -->
            <g stroke="#1c7a63" stroke-width="1.2" opacity="0.5">
              <line x1="300" y1="250" x2="20" y2="330"/>
              <line x1="300" y1="250" x2="160" y2="360"/>
              <line x1="300" y1="250" x2="300" y2="380"/>
              <line x1="300" y1="250" x2="440" y2="360"/>
              <line x1="300" y1="250" x2="580" y2="330"/>
              <path d="M60 300 L300 360 L540 300" fill="none"/>
              <path d="M120 280 L300 322 L480 280" fill="none"/>
            </g>

            <!-- coral diamonds in corners -->
            <g>
              <path d="M40 150 l26 18 l-26 18 l-26 -18 z" fill="#ff4a5f"/>
              <path d="M40 150 l26 18 l-26 18 l-26 -18 z" fill="none" stroke="#ffd2d8" stroke-width="1" opacity="0.4"/>
              <path d="M560 150 l26 18 l-26 18 l-26 -18 z" fill="#ff4a5f"/>
              <path d="M40 300 l22 15 l-22 15 l-22 -15 z" fill="#ff4a5f" opacity="0.85"/>
              <path d="M560 300 l22 15 l-22 15 l-22 -15 z" fill="#ff4a5f" opacity="0.85"/>
            </g>

            <!-- isometric cube -->
            <g stroke="#1fd6b0" stroke-width="1.6" stroke-linejoin="round">
              <!-- left face -->
              <path d="M300 210 L188 148 L188 66 L300 128 Z" fill="url(#faceL)"/>
              <!-- right face -->
              <path d="M300 210 L412 148 L412 66 L300 128 Z" fill="url(#faceR)" opacity="0.92"/>
              <!-- top face -->
              <path d="M300 128 L188 66 L300 4 L412 66 Z" fill="url(#faceT)"/>
              <!-- inner grid on left face -->
              <g stroke="#2aa287" stroke-width="0.9" opacity="0.7">
                <path d="M244 179 L244 97"/>
                <path d="M188 107 L300 169"/>
              </g>
              <!-- inner grid on right face -->
              <g stroke="#8f8c78" stroke-width="0.9" opacity="0.6">
                <path d="M356 179 L356 97"/>
                <path d="M412 107 L300 169"/>
              </g>
              <!-- top diagonals -->
              <g stroke="#c9c6b1" stroke-width="0.9" opacity="0.7">
                <path d="M244 97 L356 35"/>
                <path d="M356 97 L244 35"/>
              </g>
            </g>
          </svg>
        </div>
        <div class="badge hero__tag">ATS</div>
        <h3 class="heading-sm hero__ctitle">Protect works from plagiarism</h3>
        <p class="hero__copy">
          Allfeat Time Stamp certifies music creation with blockchain-backed,
          immutable timestamps. Prove ownership and protect works before official
          registration — trust and safe recognition from day one. Available as a
          white-label solution for CMOs.
        </p>
        <a href="#start" class="btn btn--primary hero__btn">Protect (ATS)</a>
      </article>

      <article class="card hero__card reveal" data-delay="1">
        <div class="hero__art">
          <!-- Networked vinyl nodes with red geometric web patterns -->
          <svg viewBox="0 0 600 380" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="netBg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#0c4a3b"/>
                <stop offset="1" stop-color="#08281f"/>
              </linearGradient>
              <radialGradient id="disc" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0" stop-color="#ff5c70"/>
                <stop offset="0.62" stop-color="#ff5c70"/>
                <stop offset="0.66" stop-color="#e9e6d3"/>
                <stop offset="1" stop-color="#c7c4b0"/>
              </radialGradient>
            </defs>
            <rect width="600" height="380" fill="url(#netBg)"/>

            <!-- connective network lines -->
            <g stroke="#e9e6d3" stroke-width="2" opacity="0.55">
              <line x1="300" y1="200" x2="120" y2="90"/>
              <line x1="300" y1="200" x2="500" y2="110"/>
              <line x1="300" y1="200" x2="150" y2="300"/>
              <line x1="300" y1="200" x2="470" y2="300"/>
              <line x1="120" y1="90" x2="500" y2="110"/>
              <line x1="150" y1="300" x2="470" y2="300"/>
            </g>

            <!-- vinyl-style nodes (disc + red geometric web) -->
            <g>
              <!-- central large -->
              <g transform="translate(300 200)">
                <circle r="62" fill="#111" />
                <circle r="54" fill="url(#disc)"/>
                <g stroke="#a80f22" stroke-width="1" fill="none" opacity="0.85">
                  <polygon points="0,-40 35,-12 22,32 -22,32 -35,-12"/>
                  <polygon points="0,-26 22,-8 14,20 -14,20 -22,-8"/>
                  <line x1="0" y1="-40" x2="0" y2="40"/>
                  <line x1="-35" y1="-12" x2="35" y2="-12"/>
                </g>
                <circle r="6" fill="#111"/>
              </g>
              <!-- satellites -->
              <g transform="translate(120 90)">
                <circle r="34" fill="#111"/><circle r="28" fill="url(#disc)"/>
                <g stroke="#a80f22" stroke-width="0.9" fill="none" opacity="0.8">
                  <polygon points="0,-20 18,-6 11,16 -11,16 -18,-6"/>
                </g>
                <circle r="3.4" fill="#111"/>
              </g>
              <g transform="translate(500 110)">
                <circle r="38" fill="#111"/><circle r="31" fill="url(#disc)"/>
                <g stroke="#a80f22" stroke-width="0.9" fill="none" opacity="0.8">
                  <polygon points="0,-22 20,-7 12,18 -12,18 -20,-7"/>
                  <circle r="12"/>
                </g>
                <circle r="3.6" fill="#111"/>
              </g>
              <g transform="translate(150 300)">
                <circle r="30" fill="#111"/><circle r="24" fill="url(#disc)"/>
                <g stroke="#a80f22" stroke-width="0.9" fill="none" opacity="0.8">
                  <polygon points="0,-16 14,-5 9,13 -9,13 -14,-5"/>
                </g>
                <circle r="3" fill="#111"/>
              </g>
              <g transform="translate(470 300)">
                <circle r="33" fill="#111"/><circle r="27" fill="url(#disc)"/>
                <g stroke="#a80f22" stroke-width="0.9" fill="none" opacity="0.8">
                  <polygon points="0,-18 16,-6 10,14 -10,14 -16,-6"/>
                  <line x1="0" y1="-18" x2="0" y2="14"/>
                </g>
                <circle r="3.2" fill="#111"/>
              </g>
            </g>
          </svg>
        </div>
        <div class="badge hero__tag">Soon — MIDDS</div>
        <h3 class="heading-sm hero__ctitle">Secure catalogs &amp; consent</h3>
        <p class="hero__copy">
          Music Industry Decentralized Data Structures end metadata chaos. They
          standardize and secure catalog data, linking industry IDs (IPI, IPN,
          ISNI, ISRC, ISWC, UPC) with unique blockchain IDs — one trusted,
          error-free source of truth.
        </p>
        <a href="#start" class="btn btn--ghost hero__btn">Catalogs registry</a>
      </article>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 172px;
    padding-bottom: var(--section-gap);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__head {
    max-width: 780px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .hero__title {
    margin-top: 18px;
  }

  .hero__sub {
    margin-top: 22px;
    max-width: 560px;
    margin-inline: auto;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .hero__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 16px 28px;
  }

  .hero__art {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
  }
  .hero__art svg {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 1.5s var(--ease-quart-inout);
  }
  .hero__card:hover .hero__art svg {
    transform: scale(1.04);
  }

  .hero__tag { margin: 8px 0 0 8px; }
  .hero__ctitle { padding-inline: 8px; }
  .hero__copy {
    color: var(--color-mute-cream);
    font-size: var(--text-body);
    line-height: 1.5;
    padding-inline: 8px;
  }
  .hero__btn { margin: 6px 0 0 8px; }

  @media (max-width: 820px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero { padding-top: 130px; }
  }
</style>
